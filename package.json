{
  "name": "pianor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && git config merge.docs-index.name \"generated docs blocks\" && git config merge.docs-index.driver \"node --experimental-strip-types --no-warnings tools/docs/merge-driver-cli.ts %O %A %B\" || true",
    "dev": "vite",
    "start": "vite --mode start --host 127.0.0.1 --open",
    "build": "npm run typecheck && vite build",
    "start:local": "vite build && tsx tools/start-local/cli.ts",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main --passWithNoTests",
    "test:coverage": "vitest run --coverage --exclude tools/art/pictureRules.test.ts --exclude \"src/game/ui/pixel/keri/*Picture.test.ts\" --exclude src/game/ui/pixel/keri/puuvaim.test.ts",
    "test:art": "vitest run tools/art/pictureRules.test.ts Picture.test.ts puuvaim.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:affected": "tsx tools/e2e/affected-cli.ts",
    "check": "npm run typecheck && npm run lint && npm run test:changed && npm run docs:check",
    "check:ci": "npm run typecheck && npm run lint && npm run analyze && npm run test:coverage && npm run test:art && npm run docs:check && npm run piece:build && npm run piece:lint && vite build",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "analyze": "npm run analyze:types && npm run analyze:unused && npm run analyze:dupes",
    "analyze:types": "eslint -c eslint.analyze.config.js .",
    "analyze:unused": "knip --no-progress",
    "analyze:dupes": "jscpd",
    "piece:lint": "tsx tools/piece/lint.ts",
    "piece:build": "tsx tools/piece/build.ts",
    "piece:generate": "tsx tools/generate/cli.ts",
    "piece:photo": "tsx tools/import/photo-cli.ts",
    "piece:import": "tsx tools/import/piece-cli.ts",
    "docs:index": "tsx tools/docs/cli.ts index",
    "docs:check": "tsx tools/docs/cli.ts check",
    "docs:criteria": "tsx tools/docs/cli.ts criteria",
    "docs:stale": "tsx tools/docs/cli.ts stale",
    "docs:verify": "tsx tools/docs/cli.ts verify",
    "docs:touched": "tsx tools/docs/touched-cli.ts",
    "art:render": "tsx tools/art/render-cli.ts",
    "art:check": "tsx tools/art/check-cli.ts",
    "piece:board": "tsx tools/board/cli.ts",
    "human:board": "tsx tools/board/human-cli.ts",
    "piece:preview": "vite --open /?demo=preview",
    "demo": "vite --open /?autoplay=1",
    "spike": "vite --open /spike.html"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.3",
    "fast-png": "^8.0.0",
    "globals": "^17.14.0",
    "jpeg-js": "^0.4.4",
    "jscpd": "^5.4.3",
    "knip": "^6.46.1",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-validate-links": "^13.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vfile": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
