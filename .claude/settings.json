{
  "permissions": {
    "deny": [
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__create_repository",
      "mcp__github__fork_repository"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.mjs\"",
            "timeout": 600,
            "statusMessage": "Running the fast checks (typecheck, lint, docs check)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx --no-install tsx tools/docs/privacy-cli.ts || exit 2",
            "timeout": 30,
            "statusMessage": "Checking the whole file for quotes, dates and private words (d165)..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx --no-install tsx tools/docs/privacy-cli.ts --changed || exit 2",
            "timeout": 60,
            "statusMessage": "Checking the changed files and new commit messages for quotes, dates and private words (d165)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx --no-install tsx tools/docs/privacy-cli.ts || exit 2",
            "timeout": 30,
            "statusMessage": "Checking the text for quotes, dates and private words before it is written (d165)..."
          }
        ]
      }
    ]
  }
}
