#!/bin/sh
# The privacy rules of d165 on the staged files, for every tool and person that commits (set up by `npm install`:
# `git config core.hooksPath .githooks`). A failure to run the check blocks the commit too.
cd "$(git rev-parse --show-toplevel)" || exit 1
npx --no-install tsx tools/docs/privacy-cli.ts --staged || exit 1
